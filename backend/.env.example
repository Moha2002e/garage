# Copy to .env (never commit .env) and fill in your own values.
DB_NAME=garage
DB_USER=garage
DB_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/garage

# At least 32 characters, random. Example generation: openssl rand -base64 48
JWT_SECRET=

# Initial administrator, created at startup only if no ADMIN exists yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Mail (Mailpit started separately: SMTP on 1025, UI on 8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@garage.local

FRONT_URL=http://localhost:4200
COOKIE_SECURE=false

# Optional: number of appointments the garage can handle at the same time (default 3)
# GARAGE_CAPACITY=3

# Optional: garage details printed on the invoice PDF (defaults are fictitious examples).
# GARAGE_COMPANY_NAME=Garage Exemple
# GARAGE_COMPANY_ADDRESS=12 rue Exemple
# GARAGE_COMPANY_POSTAL_CODE=0000
# GARAGE_COMPANY_CITY=Ville Exemple
# GARAGE_COMPANY_COUNTRY=Belgique
# GARAGE_COMPANY_VAT_NUMBER=BE0000.000.000
# GARAGE_COMPANY_IBAN=BE00 0000 0000 0000
# GARAGE_COMPANY_BIC=EXAMBEBB
# GARAGE_COMPANY_EMAIL=contact@garage-exemple.invalid
# GARAGE_COMPANY_PHONE=+32 00 00 00 00
# VAT percentage of the invoices (default 21)
# INVOICE_VAT_RATE=21
