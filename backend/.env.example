# Copy to .env (never commit .env) and fill in your own values.
DB_NAME=garage
DB_USER=garage
DB_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/garage

# At least 32 characters, random. Example generation: openssl rand -base64 48
JWT_SECRET=

# Initial administrator, created at startup only if no ADMIN exists yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Mail (Mailpit started separately: SMTP on 1025, UI on 8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@garage.local

FRONT_URL=http://localhost:4200
COOKIE_SECURE=false
